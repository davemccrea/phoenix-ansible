services:
  app:
    image: ghcr.io/{{ github_username }}/{{ project_name }}:latest
    container_name: "{{ project_name }}"
    restart: unless-stopped
    network_mode: host
    environment:
      PHX_SERVER: "true"
      PHX_HOST: "{{ project_url }}"
      PORT: "{{ app_port }}"
      SECRET_KEY_BASE: "{{ secret_key_base }}"
      TOKEN_SIGNING_SECRET: "{{ token_signing_secret }}"
      RELEASE_COOKIE: "{{ release_cookie }}"
      RELEASE_DISTRIBUTION: name
      RELEASE_NODE: "{{ project_name }}@127.0.0.1"
      MAINTENANCE_MODE: "{{ maintenance_mode | string | lower }}"
      MAINTENANCE_BYPASS_SECRET: "{{ maintenance_bypass_secret }}"
      DATABASE_URL: "{{ database_url }}"
      STRIPE_SECRET_KEY: "{{ stripe_secret_key }}"
      STRIPE_PUBLISHABLE_KEY: "{{ stripe_publishable_key }}"
      STRIPE_WEBHOOK_SECRET: "{{ stripe_webhook_secret }}"
      GOOGLE_CLIENT_ID: "{{ google_client_id }}"
      GOOGLE_CLIENT_SECRET: "{{ google_client_secret }}"
      HERE_API_KEY: "{{ here_api_key }}"
      IMGPROXY_PREFIX: "{{ imgproxy_prefix }}"
      IMGPROXY_KEY: "{{ imgproxy_key }}"
      IMGPROXY_SALT: "{{ imgproxy_salt }}"

  imgproxy:
    image: darthsim/imgproxy:v3
    restart: unless-stopped
    network_mode: host
    environment:
      IMGPROXY_KEY: "{{ imgproxy_key }}"
      IMGPROXY_SALT: "{{ imgproxy_salt }}"
      IMGPROXY_LOCAL_FILESYSTEM_ROOT: /images
    volumes:
      - /opt/{{ project_name }}/images:/images

  papra:
    image: ghcr.io/papra-hq/papra:latest
    container_name: papra
    restart: unless-stopped
    network_mode: host
    environment:
      AUTH_SECRET: "{{ papra_auth_secret }}"
      APP_BASE_URL: "{{ papra_base_url }}"
      AUTH_IS_REGISTRATION_ENABLED: false
      INTAKE_EMAILS_IS_ENABLED: true
      INTAKE_EMAILS_DRIVER: "catch-all"
      INTAKE_EMAILS_CATCH_ALL_DOMAIN: "ingest.{{ project_url }}"
      INTAKE_EMAILS_WEBHOOK_SECRET: "{{ papra_intake_webhook_secret }}"
    volumes:
      - ./papra:/app/app-data
    user: 1000:1000

  cloudflared:
    image: cloudflare/cloudflared:latest
    restart: unless-stopped
    network_mode: host
    command: tunnel --no-autoupdate run
    environment:
      TUNNEL_TOKEN: "{{ cloudflare_tunnel_token }}"
