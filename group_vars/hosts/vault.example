# Example vault file. Copy to `vault` and encrypt with:
#
#   cp group_vars/hosts/vault.example group_vars/hosts/vault
#   # edit values, then:
#   ansible-vault encrypt group_vars/hosts/vault
#
# Or create from scratch with `ansible-vault create group_vars/hosts/vault`
# and paste the keys below.
#
# Every variable here is referenced from `group_vars/hosts/vars`.

# App
vault_secret_key_base: "generate with: mix phx.gen.secret"
vault_token_signing_secret: "generate with: mix phx.gen.secret"
vault_release_cookie: "generate with: openssl rand -base64 32"
vault_maintenance_bypass_secret: "any random string"

# Database
vault_db_user: "your_db_user"
vault_db_password: "your_db_password"

# GitHub (personal access token with read:packages scope for ghcr.io pulls)
vault_github_token: "ghp_..."

# Tailscale (auth key from https://login.tailscale.com/admin/settings/keys)
vault_tailscale_authkey: "tskey-auth-..."

# Stripe (https://dashboard.stripe.com/apikeys)
vault_stripe_secret_key: "sk_live_..."
vault_stripe_publishable_key: "pk_live_..."
vault_stripe_webhook_secret: "whsec_..."

# Google OAuth (https://console.cloud.google.com/apis/credentials)
vault_google_client_id: "....apps.googleusercontent.com"
vault_google_client_secret: "GOCSPX-..."

# HERE Maps API (https://platform.here.com)
vault_here_api_key: "your_here_api_key"

# imgproxy (generate with: xxd -g 2 -l 64 -p /dev/random | tr -d '\n')
vault_imgproxy_key: "hex-encoded key"
vault_imgproxy_salt: "hex-encoded salt"

# Cloudflare Tunnel (token from Cloudflare Zero Trust dashboard)
vault_cloudflare_tunnel_token: "eyJ..."

# Papra (generate with: openssl rand -base64 32)
vault_papra_auth_secret: "your_papra_auth_secret"
